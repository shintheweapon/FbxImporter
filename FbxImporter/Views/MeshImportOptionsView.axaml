<rxui:ReactiveWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:rxui="http://reactiveui.net"
                     xmlns:vm="clr-namespace:FbxImporter.ViewModels"
                     mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="300"
                     x:TypeArguments="vm:MeshImportOptionsViewModel" 
                     x:Class="FbxImporter.Views.MeshImportOptionsView"
                     WindowStartupLocation="CenterOwner"
                     Title="Mesh Import Options"
                     Height="520"
                     Width="350"
                     MinHeight="520"
                     MinWidth="350"
                     CanResize="True">
    <Design.DataContext>
        <vm:MeshImportOptionsViewModel/>
    </Design.DataContext>
    
    <Border>
        <Grid RowDefinitions="40, *, 40, 180, 40" Margin="5">
            <TextBox Name="FilterTextBox" Watermark="Search Materials..." Text="{Binding Filter}" Grid.Row="0" Margin="5"/>
            <ListBox Name="MaterialListBox" ItemsSource="{Binding FilteredMaterials, Mode=OneWay}" SelectedItems="{Binding FilteredMaterialSelection}"
                     SelectionMode="Single" AutoScrollToSelectedItem="False"
                     VerticalAlignment="Stretch" Grid.Row="1" Margin="5">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <TextBox Text="{Binding SelectedMaterial}" Watermark="No Material Selected" IsReadOnly="True" CaretBrush="Transparent" Grid.Row="2" Margin="5"/>
            <ScrollViewer Grid.Row="3" Margin="5">
                <Grid RowDefinitions="30, 30, 30, 30, 30, *" ColumnDefinitions="*, *" Margin="5">
                    <Grid.Styles>
                        <!-- Stretch content so tooltips are shown when hovering any part of the combo box -->
                        <Style Selector="ComboBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </Grid.Styles>
                    <TextBlock Text="Flip Faces" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
                    <CheckBox IsChecked="{Binding FlipFaces}" ToolTip.Tip="Flips the faces of the model." Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"/>
                    <TextBlock Text="Weighting Mode" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
                    <ComboBox ItemsSource="{Binding WeightingModes}" SelectedItem="{Binding Weighting}" Grid.Row="1" Grid.Column="1">
                        <ComboBox.DataTemplates>
                            <DataTemplate DataType="vm:WeightingMode">
                                <TextBlock Text="{Binding Name}" Background="Transparent" ToolTip.Tip="{Binding Description}"/>
                            </DataTemplate>
                        </ComboBox.DataTemplates>
                    </ComboBox>
                    <TextBlock Text="Transform" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"/>
                    <ComboBox ItemsSource="{Binding TransformPresets}" SelectedItem="{Binding TransformPreset}" Grid.Row="2" Grid.Column="1">
                        <ComboBox.DataTemplates>
                            <DataTemplate DataType="vm:TransformPreset">
                                <TextBlock Text="{Binding Name}" Background="Transparent" ToolTip.Tip="{Binding Description}"/>
                            </DataTemplate>
                        </ComboBox.DataTemplates>
                    </ComboBox>
                    <ContentControl Content="{Binding CustomTransform}" IsVisible="{Binding UseCustomTransform}" Height="100" Grid.Row="5" Grid.Column="1" />
                    <TextBlock Text="ER Tangents" ToolTip.Tip="Rebuilds the tangents from the mesh and its UVs&#10;in Elden Ring's own convention (tangent along +V),&#10;so normal maps in the DirectX layout shade as on vanilla models.&#10;Checked on Elden Ring only.&#10;Starts ticked for Elden Ring FLVERs and keeps your last choice per game.&#10;Untick to keep the FBX file's tangents." VerticalAlignment="Center" Grid.Row="3" Grid.Column="0"/>
                    <CheckBox IsChecked="{Binding ErTangents}" ToolTip.Tip="Rebuilds the tangents from the mesh and its UVs&#10;in Elden Ring's own convention (tangent along +V),&#10;so normal maps in the DirectX layout shade as on vanilla models.&#10;Checked on Elden Ring only.&#10;Starts ticked for Elden Ring FLVERs and keeps your last choice per game.&#10;Untick to keep the FBX file's tangents." Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right"/>
                    <TextBlock Text="Cloth W (cloth materials only)" ToolTip.Tip="Sets the bitangent sign (W) to -1 on every tangent ER Tangents builds.&#10;Almost all of Elden Ring's own cloth meshes store it that way:&#10;meshes whose material has &quot;cloth&quot; in its name, used for Havok cloth simulation.&#10;Use it only with a cloth material: on other meshes,&#10;mirrored UV islands shade wrongly.&#10;Measured on the game's files, not tested in game.&#10;Needs ER Tangents. Starts unticked for every import." VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"/>
                    <CheckBox IsChecked="{Binding ClothW}" IsEnabled="{Binding ErTangents}" ToolTip.Tip="Sets the bitangent sign (W) to -1 on every tangent ER Tangents builds.&#10;Almost all of Elden Ring's own cloth meshes store it that way:&#10;meshes whose material has &quot;cloth&quot; in its name, used for Havok cloth simulation.&#10;Use it only with a cloth material: on other meshes,&#10;mirrored UV islands shade wrongly.&#10;Measured on the game's files, not tested in game.&#10;Needs ER Tangents. Starts unticked for every import." Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right"/>
                </Grid>
            </ScrollViewer>
            <Grid ColumnDefinitions="*, *" Grid.Row="4">
                <Button Content="Cancel" Command="{Binding CancelCommand}" ToolTip.Tip="Shortcut: Esc" Margin="0, 0, 2, 0" Grid.Column="0" />
                <Button Content="Ok" Command="{Binding ConfirmCommand}" ToolTip.Tip="Shortcut: Enter" Margin="2, 0, 0, 0" Grid.Column="1" />
            </Grid>
        </Grid>
    </Border>
    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
    </Window.KeyBindings>
</rxui:ReactiveWindow>
